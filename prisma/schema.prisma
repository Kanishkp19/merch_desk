// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A quote request submitted from a launch plan. `payload` is the immutable
/// snapshot the creator reviewed at submission; later plan edits never change
/// it. Operator activity (status, notes, recorded quotes, decisions) lives in
/// `working` so revisions stay distinguishable from the original request.
model LaunchRequest {
  id           String   @id // public reference (e.g. MD-XXXXXX) — display identifier only
  status       String   @default("submitted") // submitted | needs_info | quote_ready | closed
  creatorName  String
  creatorEmail String
  /// SHA-256 hex of the creator credential (never the credential itself).
  /// Null = legacy record from before credentials existed; creator routes
  /// refuse it until the operator issues a key from the operator queue.
  creatorKeyHash String?
  /// Idempotency key from the submitting browser. Unique at the database level
  /// so concurrent retries collide here instead of creating duplicate requests.
  clientRequestId String @unique
  /// SHA-256 hex of the payload JSON at first submission — detects reuse of an
  /// idempotency key with different request data.
  payloadHash  String?
  payload      String // immutable JSON snapshot of the request
  working      String @default("{}") // JSON: events[], quotes[], sampleApproved?, productionAuthorized?
  /// Optimistic-concurrency counter: updates must match the version they read,
  /// so concurrent operator and creator edits cannot overwrite each other.
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}